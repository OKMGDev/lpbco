{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 0;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }
  .ai-editorial-{{ ai_gen_id }}__inner { width: 100%; }
  .ai-editorial-{{ ai_gen_id }}__kicker { margin: 0 0 12px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__headline { max-width: 900px; margin: 0 0 28px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(36px, 6vw, {{ block.settings.heading_size }}px); font-weight: 400; line-height: 1.04; letter-spacing: -.035em; }
  .ai-editorial-{{ ai_gen_id }}__layout { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(220px, .75fr); gap: clamp(22px, 4vw, 56px); align-items: start; }
  .ai-editorial-{{ ai_gen_id }}__feature { display: block; color: inherit; text-decoration: none; }
  .ai-editorial-{{ ai_gen_id }}__image-wrap { width: 100%; overflow: hidden; background: #f1f1ed; }
  .ai-editorial-{{ ai_gen_id }}__image { display: block; width: 100%; height: auto; aspect-ratio: 1.48; object-fit: cover; }
  .ai-editorial-{{ ai_gen_id }}__placeholder { display: flex; min-height: 260px; aspect-ratio: 1.48; align-items: center; justify-content: center; position: relative; background: #f1f1ed; }
  .ai-editorial-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; }
  .ai-editorial-{{ ai_gen_id }}__empty { position: absolute; bottom: 12px; left: 12px; padding: 8px 10px; background: #fff; color: #373737; font-size: 13px; }
  .ai-editorial-{{ ai_gen_id }}__caption { margin-top: 12px; font-size: 12px; line-height: 1.5; color: {{ block.settings.muted_color }}; }
  .ai-editorial-{{ ai_gen_id }}__side { padding-top: 4px; }
  .ai-editorial-{{ ai_gen_id }}__rule { border: 0; border-top: 1px solid {{ block.settings.rule_color }}; margin: 0 0 22px; }
  .ai-editorial-{{ ai_gen_id }}__story { padding: 0 0 22px; margin: 0 0 22px; border-bottom: 1px solid {{ block.settings.rule_color }}; }
  .ai-editorial-{{ ai_gen_id }}__story:last-child { margin-bottom: 0; }
  .ai-editorial-{{ ai_gen_id }}__story-title { margin: 0 0 9px; font-family: Georgia, 'Times New Roman', serif; font-size: 25px; font-weight: 400; line-height: 1.15; }
  .ai-editorial-{{ ai_gen_id }}__story-copy { margin: 0 0 12px; font-size: 14px; line-height: 1.65; }
  .ai-editorial-{{ ai_gen_id }}__link { display: inline-block; color: {{ block.settings.text_color }}; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-decoration: underline; text-underline-offset: 4px; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__link:focus-visible, .ai-editorial-{{ ai_gen_id }}__feature:focus-visible { outline: 2px solid {{ block.settings.accent_color }}; outline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} { width: 100%; padding: {{ block.settings.vertical_padding | divided_by: 2 }}px 0; }
    .ai-editorial-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; gap: 28px; }
    .ai-editorial-{{ ai_gen_id }}__headline { margin-bottom: 22px; }
    .ai-editorial-{{ ai_gen_id }}__side { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .ai-editorial-{{ ai_gen_id }}__rule { display: none; }
    .ai-editorial-{{ ai_gen_id }}__story { margin: 0; }
  }
  @media screen and (max-width: 480px) {
    .ai-editorial-{{ ai_gen_id }}__side { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__kicker">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__headline">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-editorial-{{ ai_gen_id }}__layout">
      <div>
        {% if block.settings.feature_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__feature" href="{{ block.settings.feature_link }}" aria-label="{{ block.settings.feature_title | escape }}">{% endif %}
          <div class="ai-editorial-{{ ai_gen_id }}__image-wrap">
            {% if block.settings.feature_image %}
              <img class="ai-editorial-{{ ai_gen_id }}__image" src="{{ block.settings.feature_image | image_url: width: 1800 }}" alt="{{ block.settings.feature_image.alt | default: block.settings.feature_title | escape }}" loading="lazy" width="{{ block.settings.feature_image.width }}" height="{{ block.settings.feature_image.height }}">
            {% else %}
              <div class="ai-editorial-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-editorial-{{ ai_gen_id }}__empty">Add a feature image</span></div>
            {% endif %}
          </div>
          {% if block.settings.feature_caption != blank %}<div class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.feature_caption | escape }}</div>{% endif %}
        {% if block.settings.feature_link != blank %}</a>{% endif %}
      </div>
      <aside class="ai-editorial-{{ ai_gen_id }}__side" aria-label="Editorial stories">
        <hr class="ai-editorial-{{ ai_gen_id }}__rule">
        {% for i in (1..3) %}
          {% liquid
            assign title_key = 'story_' | append: i | append: '_title'
            assign copy_key = 'story_' | append: i | append: '_copy'
            assign link_key = 'story_' | append: i | append: '_link'
            assign title_value = block.settings[title_key]
            assign copy_value = block.settings[copy_key]
            assign link_value = block.settings[link_key]
          %}
          {% if title_value != blank or copy_value != blank %}
            <article class="ai-editorial-{{ ai_gen_id }}__story">
              {% if title_value != blank %}<h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{{ title_value | escape }}</h3>{% endif %}
              {% if copy_value != blank %}<p class="ai-editorial-{{ ai_gen_id }}__story-copy">{{ copy_value | escape }}</p>{% endif %}
              {% if link_value != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ link_value }}">Read story</a>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial layout",
  "settings": [
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the journal" },
    { "type": "text", "id": "heading", "label": "Main heading", "default": "Stories, people and places worth raising a glass to." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Feature story" },
    { "type": "image_picker", "id": "feature_image", "label": "Feature image" },
    { "type": "text", "id": "feature_caption", "label": "Image caption", "default": "A closer look at the craft, character and coastline behind every pour." },
    { "type": "text", "id": "feature_title", "label": "Feature image accessible label", "default": "Featured editorial story" },
    { "type": "url", "id": "feature_link", "label": "Feature link" },
    { "type": "header", "content": "Side stories" },
    { "type": "text", "id": "story_1_title", "label": "Story 1 heading", "default": "Brewed by the coast" },
    { "type": "textarea", "id": "story_1_copy", "label": "Story 1 summary", "default": "Meet the makers and the coastal community that shape what we brew." },
    { "type": "url", "id": "story_1_link", "label": "Story 1 link" },
    { "type": "text", "id": "story_2_title", "label": "Story 2 heading", "default": "A little more about hops" },
    { "type": "textarea", "id": "story_2_copy", "label": "Story 2 summary", "default": "Explore the ingredients and thoughtful choices behind each release." },
    { "type": "url", "id": "story_2_link", "label": "Story 2 link" },
    { "type": "text", "id": "story_3_title", "label": "Story 3 heading", "default": "Gather around the table" },
    { "type": "textarea", "id": "story_3_copy", "label": "Story 3 summary", "default": "Good beer is better shared. Find inspiration for your next get-together." },
    { "type": "url", "id": "story_3_link", "label": "Story 3 link" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 40, "max": 72, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "muted_color", "label": "Caption text", "default": "#555555" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#263C32" },
    { "type": "color", "id": "rule_color", "label": "Divider", "default": "#D8D8D2" }
  ],
  "presets": [{ "name": "Editorial layout" }],
  "tag": null,
  "class": "editorial-layout-block"
}
{% endschema %}