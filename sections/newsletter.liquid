{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      background-color: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.text_color != blank -%}
      --text-color: {{ section.settings.text_color }};
      color: var(--text-color);
    {%- endif -%}
    position: relative;
    overflow: hidden;
  }

  #EmailSignup-{{ section.id }} .email-signup__card {
    {%- if section.settings.card_background_color != blank -%}
      background-color: {{ section.settings.card_background_color }};
    {%- endif -%}
  }

  #EmailSignup-{{ section.id }} .email-signup__content-inner {
    {%- if section.settings.inner_background_color != blank -%}
      background-color: {{ section.settings.inner_background_color }};
    {%- endif -%}
  }

  #EmailSignup-{{ section.id }} .email-signup__content svg {
    {%- if section.settings.background_icons_color != blank -%}
      color: {{ section.settings.background_icons_color }};
    {%- endif -%}
  }
{%- endstyle -%}

<section
  id="EmailSignup-{{ section.id }}"
  class="email-signup section-{{ section.id }}-padding"
>
  <div class="page-width">
    <div class="email-signup__card">
      <div class="email-signup__content">
        {% render 'event-card-icons' %}
        <div class="email-signup__content-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="email-signup__heading" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
              {%- when 'paragraph' -%}
                {%- if block.settings.text != blank -%}
                  <div class="email-signup__text rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              {%- when 'email_form' -%}
                <div class="email-signup__form" {{ block.shopify_attributes }}>
                  <div id="CONTACTA_6aa0fa9641883d94d08a314c"></div>
                  <script type="text/javascript" async>
                    var script = document.createElement('script');
                    script.type = 'text/javascript';
                    script.src = 'https://forms.contacta.io/6aa0fa9641883d94d08a314c.js';
                    document.getElementsByTagName('head')[0].appendChild(script);
                  </script>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section email-signup-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#b6dfe9"
    },
    {
      "type": "color",
      "id": "background_icons_color",
      "label": "Background icons color",
      "default": "#f8f5ed"
    },
    {
      "type": "color",
      "id": "inner_background_color",
      "label": "Inner background color",
      "default": "#53bcae"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "html",
          "id": "heading",
          "default": "THIRSTY FOR MORE?",
          "label": "t:sections.newsletter.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Stay connected with Long Point Brewing Co. and be the first to hear about new beers, upcoming events, and everything happening at the brewery.</p>",
          "label": "t:sections.newsletter.blocks.paragraph.settings.paragraph.label"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
