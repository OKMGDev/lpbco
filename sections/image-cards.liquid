{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ImageCards-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      background-color: {{ section.settings.background_color }};
    {%- endif -%}
  }

  #ImageCards-{{ section.id }} .image-cards__card {
    background-color: {{ section.settings.card_background_color }};
    color: {{ section.settings.card_text_color }};
  }
{%- endstyle -%}

<div class="image-cards-section section-{{ section.id }}-padding" id="ImageCards-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="image-cards__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="image-cards__grid">
      {%- for block in section.blocks -%}
        <article class="image-cards__card" {{ block.shopify_attributes }}>
          <div class="image-cards__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title, class: 'image-cards__image'
              }}
            {%- else -%}
              <div class="image-cards__placeholder" role="img" aria-label="Image coming soon"></div>
            {%- endif -%}
          </div>

          <div class="image-cards__content">
            {%- if block.settings.title != blank -%}
              <h3 class="image-cards__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.textbox != blank -%}
              <div class="image-cards__card-text rte">{{ block.settings.textbox }}</div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F0E7D8"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#373737"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "richtext",
          "id": "textbox",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
