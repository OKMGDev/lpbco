{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #WallOfFame-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      background-color: {{ section.settings.background_color }};
    {%- endif -%}
  }
{%- endstyle -%}

{%- liquid
  assign images_per_page = section.settings.images_per_page | default: 4
  assign image_blocks = section.blocks | where: 'type', 'image'
-%}

<div
  id="WallOfFame-{{ section.id }}"
  class="wall-of-fame-section section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="wall-of-fame__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <wall-of-fame
      class="wall-of-fame"
      data-per-page="{{ images_per_page }}"
      data-section-id="{{ section.id }}"
    >
      <div class="wall-of-fame__grid" data-gallery>
        {%- if image_blocks.size > 0 -%}
          {%- for block in image_blocks -%}
            <div
              class="wall-of-fame__item"
              data-gallery-item
              {% if forloop.index > images_per_page %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign image_alt = block.settings.image.alt | default: section.settings.heading
                -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 750, 900',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
                    alt: image_alt,
                    class: 'wall-of-fame__image'
                }}
              {%- else -%}
                <div class="wall-of-fame__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="wall-of-fame__empty">
            <p>Add images in the theme editor to build your Wall of Fame.</p>
          </div>
        {%- endif -%}
      </div>

      {%- if image_blocks.size > images_per_page -%}
        <div class="wall-of-fame__controls" aria-label="Gallery pagination">
          <button
            class="button button--deep-water wall-of-fame__button"
            type="button"
            data-prev
            aria-label="Previous images"
          >
            Previous
          </button>
          <span class="wall-of-fame__page" data-page aria-live="polite"></span>
          <button
            class="button button--deep-water wall-of-fame__button"
            type="button"
            data-next
            aria-label="Next images"
          >
            Next
          </button>
        </div>
      {%- endif -%}
    </wall-of-fame>
  </div>
</div>

<script>
  (() => {
    if (customElements.get('wall-of-fame')) return;

    class WallOfFame extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-gallery-item]'));
        this.previous = this.querySelector('[data-prev]');
        this.next = this.querySelector('[data-next]');
        this.pageLabel = this.querySelector('[data-page]');
        this.perPage = Number(this.dataset.perPage) || 4;
        this.page = 0;

        if (!this.items.length || !this.previous || !this.next) return;

        this.previous.addEventListener('click', () => this.showPage(this.page - 1));
        this.next.addEventListener('click', () => this.showPage(this.page + 1));
        this.showPage(0);
      }

      showPage(page) {
        const pages = Math.ceil(this.items.length / this.perPage);
        this.page = Math.max(0, Math.min(page, pages - 1));

        this.items.forEach((item, index) => {
          const start = this.page * this.perPage;
          const end = start + this.perPage;
          item.hidden = index < start || index >= end;
        });

        this.previous.disabled = this.page === 0;
        this.next.disabled = this.page === pages - 1;

        if (this.pageLabel) {
          this.pageLabel.textContent = `${this.page + 1} / ${pages}`;
        }
      }
    }

    customElements.define('wall-of-fame', WallOfFame);
  })();
</script>

{% schema %}
{
  "name": "Wall of Fame",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wall of Fame"
    },
    {
      "type": "range",
      "id": "images_per_page",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Images per page",
      "default": 4
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wall of Fame",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
