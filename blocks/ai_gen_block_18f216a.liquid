{% doc %}
  @prompt
    image on the left, then header, then description with a book now button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-event-booking-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-event-booking-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    width: 100%;
    overflow: hidden;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-event-booking-{{ ai_gen_id }}__media {
    min-height: {{ block.settings.image_height }}px;
    background: {{ block.settings.image_placeholder_color }};
  }

  .ai-event-booking-{{ ai_gen_id }}__media img,
  .ai-event-booking-{{ ai_gen_id }}__media-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.image_height }}px;
    object-fit: cover;
  }

  .ai-event-booking-{{ ai_gen_id }}__media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-booking-{{ ai_gen_id }}__media-placeholder svg {
    width: 100%;
    max-width: 240px;
    height: auto;
  }

  .ai-event-booking-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-event-booking-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-event-booking-{{ ai_gen_id }}__description {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
  }

  .ai-event-booking-{{ ai_gen_id }}__description p {
    margin: 0 0 12px;
  }

  .ai-event-booking-{{ ai_gen_id }}__description p:last-child {
    margin-bottom: 0;
  }

  .ai-event-booking-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-event-booking-{{ ai_gen_id }}__button:hover {
    opacity: 0.82;
  }

  .ai-event-booking-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-event-booking-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
    }

    .ai-event-booking-{{ ai_gen_id }}__media,
    .ai-event-booking-{{ ai_gen_id }}__media img,
    .ai-event-booking-{{ ai_gen_id }}__media-placeholder {
      min-height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-event-booking-{{ ai_gen_id }}__content {
      padding: 28px 24px;
    }
  }
{% endstyle %}

<div class="ai-event-booking-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-event-booking-{{ ai_gen_id }}__inner">
    <div class="ai-event-booking-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 1400 }}"
          alt="{{ block.settings.image.alt | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-event-booking-{{ ai_gen_id }}__media-placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-event-booking-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}
        <h2 class="ai-event-booking-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-event-booking-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-event-booking-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">
          {{ block.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Event booking card",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book your next event"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Bring your next celebration to Long Point Brewing Co. Get in touch with our team to plan your event.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 240,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile image height",
      "min": 180,
      "max": 500,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#373737"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "Image placeholder",
      "default": "#E6E6E6"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D1D1D1"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Card border",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Event booking card"
    }
  ],
  "tag": null,
  "class": "event-booking-card"
}
{% endschema %}