{% doc %}
  @prompt
    Create a grouped product section for the All products collection page. Display three distinct groups with headings Beer, Merch, and Gift Cards, with the matching products directly beneath each heading. Let the merchant select the collection supplying products for each group. Match the theme's existing product card styling and responsive layout. and move the header All to the top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grouped-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: rgb(var(--color-foreground));
  }
  .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__title {
    margin: 0 0 2.5rem;
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    line-height: 1.1;
  }
  .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__group { margin: 0 0 4rem; }
  .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__heading {
    margin: 0 0 1.8rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.2;
  }
  .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 1.6rem;
    row-gap: 3rem;
  }
  .ai-grouped-products-{{ ai_gen_id }} .card-wrapper { height: 100%; }
  .ai-grouped-products-{{ ai_gen_id }} .card {
    height: 100%;
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }
  .ai-grouped-products-{{ ai_gen_id }} .card__inner {
    position: relative;
    overflow: hidden;
    background: rgba(var(--color-foreground), .04);
    border-radius: var(--media-radius, 0);
  }
  .ai-grouped-products-{{ ai_gen_id }} .card__media {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .ai-grouped-products-{{ ai_gen_id }} .card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-grouped-products-{{ ai_gen_id }} .card__content { padding: 1.2rem 0; }
  .ai-grouped-products-{{ ai_gen_id }} .card__information { text-align: {{ settings.card_text_alignment }}; }
  .ai-grouped-products-{{ ai_gen_id }} .card__heading {
    margin: 0 0 .6rem;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .ai-grouped-products-{{ ai_gen_id }} .card__heading a { color: inherit; text-decoration: none; }
  .ai-grouped-products-{{ ai_gen_id }} .price { font-size: 1.4rem; }
  .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__empty {
    margin: 0;
    color: rgba(var(--color-foreground), .75);
    font-size: 1.5rem;
  }
  @media screen and (max-width: 749px) {
    .ai-grouped-products-{{ ai_gen_id }} { width: 100%; }
    .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
    .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__title { margin-bottom: 2rem; }
    .ai-grouped-products-{{ ai_gen_id }} .ai-grouped-products__group { margin-bottom: 3rem; }
  }
{% endstyle %}

<div class="ai-grouped-products-{{ ai_gen_id }} page-width" {{ block.shopify_attributes }}>
  <h1 class="ai-grouped-products__title">{{ block.settings.page_heading | escape }}</h1>
  {% for i in (1..3) %}
    {% liquid
      assign collection_setting_key = 'group_' | append: i | append: '_collection'
      assign collection_heading_key = 'group_' | append: i | append: '_heading'
      assign chosen_collection = block.settings[collection_setting_key]
      assign group_heading = block.settings[collection_heading_key]
    %}
    <section class="ai-grouped-products__group" aria-labelledby="ai-group-heading-{{ ai_gen_id }}-{{ i }}">
      <h2 class="ai-grouped-products__heading" id="ai-group-heading-{{ ai_gen_id }}-{{ i }}">{{ group_heading | escape }}</h2>
      {% if chosen_collection != blank and chosen_collection.products_count > 0 %}
        <div class="ai-grouped-products__grid">
          {% for product in chosen_collection.products limit: 12 %}
            <div class="card-wrapper">
              <div class="card">
                <div class="card__inner">
                  <a class="card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 360, 540, 720, 900', sizes: '(min-width: 750px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title | escape }}
                    {% else %}
                      <div class="card__media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                    {% endif %}
                  </a>
                </div>
                <div class="card__content">
                  <div class="card__information">
                    <h3 class="card__heading"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                    <div class="price">{% if product.price_varies %}<span>From </span>{% endif %}{{ product.price | money }}</div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="ai-grouped-products__empty">Select a collection for this group to show products.</p>
      {% endif %}
    </section>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Grouped products",
  "settings": [
    {
      "type": "text",
      "id": "page_heading",
      "label": "Page heading",
      "default": "All"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Beer group"
    },
    {
      "type": "text",
      "id": "group_1_heading",
      "label": "Heading",
      "default": "Beer"
    },
    {
      "type": "collection",
      "id": "group_1_collection",
      "label": "Product collection"
    },
    {
      "type": "header",
      "content": "Merch group"
    },
    {
      "type": "text",
      "id": "group_2_heading",
      "label": "Heading",
      "default": "Merch"
    },
    {
      "type": "collection",
      "id": "group_2_collection",
      "label": "Product collection"
    },
    {
      "type": "header",
      "content": "Gift cards group"
    },
    {
      "type": "text",
      "id": "group_3_heading",
      "label": "Heading",
      "default": "Gift Cards"
    },
    {
      "type": "collection",
      "id": "group_3_collection",
      "label": "Product collection"
    }
  ],
  "presets": [
    {
      "name": "Grouped products"
    }
  ],
  "tag": null,
  "class": "grouped-products-block"
}
{% endschema %}