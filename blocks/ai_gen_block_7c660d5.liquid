{% doc %}
  @prompt
    four images square next to each other, then able to add more images and click next to view them and have one heading at the top called "wall of Fame", i only want 4 photos showing until you click next to view the rest in the carousel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wall-of-fame-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }
  .ai-wall-of-fame-{{ ai_gen_id }}__inner { width: 100%; }
  .ai-wall-of-fame-{{ ai_gen_id }}__heading { margin: 0 0 24px; text-align: center; font-size: {{ block.settings.heading_size }}px; color: {{ block.settings.text_color }}; }
  .ai-wall-of-fame-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: {{ block.settings.image_gap }}px; }
  .ai-wall-of-fame-{{ ai_gen_id }}__item { display: block; overflow: hidden; aspect-ratio: 1 / 1; background: #f3f3f3; }
  .ai-wall-of-fame-{{ ai_gen_id }}__item[hidden] { display: none; }
  .ai-wall-of-fame-{{ ai_gen_id }}__item img, .ai-wall-of-fame-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-wall-of-fame-{{ ai_gen_id }}__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ai-wall-of-fame-{{ ai_gen_id }}__placeholder svg { color: #666666; }
  .ai-wall-of-fame-{{ ai_gen_id }}__empty { grid-column: 1 / -1; padding: 24px; text-align: center; color: {{ block.settings.text_color }}; background: {{ block.settings.background_color }}; border: 1px dashed #777777; }
  .ai-wall-of-fame-{{ ai_gen_id }}__empty p { margin: 12px 0 0; }
  .ai-wall-of-fame-{{ ai_gen_id }}__controls { display: flex; justify-content: center; align-items: center; gap: 18px; margin-top: 20px; }
  .ai-wall-of-fame-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 8px 18px; color: {{ block.settings.button_text_color }}; background: {{ block.settings.button_color }}; border: 1px solid {{ block.settings.button_color }}; cursor: pointer; font: inherit; }
  .ai-wall-of-fame-{{ ai_gen_id }}__button:disabled { opacity: 0.45; cursor: not-allowed; }
  .ai-wall-of-fame-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  .ai-wall-of-fame-{{ ai_gen_id }}__page { min-width: 5ch; text-align: center; color: {{ block.settings.text_color }}; }
  @media screen and (max-width: 749px) {
    .ai-wall-of-fame-{{ ai_gen_id }} { width: 100%; }
    .ai-wall-of-fame-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ai-wall-of-fame-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}

<wall-of-fame-{{ ai_gen_id }} class="ai-wall-of-fame-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-wall-of-fame-{{ ai_gen_id }}__inner">
    <h2 class="ai-wall-of-fame-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-wall-of-fame-{{ ai_gen_id }}__grid" data-gallery>
      {% assign image_count = 0 %}
      {% for i in (1..12) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        {% if image != blank %}
          {% assign image_count = image_count | plus: 1 %}
          <div class="ai-wall-of-fame-{{ ai_gen_id }}__item" data-gallery-item{% if image_count > 4 %} hidden{% endif %}>
            <img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
          </div>
        {% endif %}
      {% endfor %}
      {% if image_count == 0 %}
        <div class="ai-wall-of-fame-{{ ai_gen_id }}__empty">
          <div class="ai-wall-of-fame-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          <p>Add images in the block settings to build your Wall of Fame.</p>
        </div>
      {% endif %}
    </div>
    {% if image_count > 4 %}
      <div class="ai-wall-of-fame-{{ ai_gen_id }}__controls" aria-label="Gallery pagination">
        <button class="ai-wall-of-fame-{{ ai_gen_id }}__button" type="button" data-prev aria-label="Previous images">Previous</button>
        <span class="ai-wall-of-fame-{{ ai_gen_id }}__page" data-page aria-live="polite"></span>
        <button class="ai-wall-of-fame-{{ ai_gen_id }}__button" type="button" data-next aria-label="Next images">Next</button>
      </div>
    {% endif %}
  </div>
</wall-of-fame-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'wall-of-fame-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class WallOfFame extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-gallery-item]'));
        this.previous = this.querySelector('[data-prev]');
        this.next = this.querySelector('[data-next]');
        this.pageLabel = this.querySelector('[data-page]');
        this.page = 0;
        if (!this.items.length || !this.previous || !this.next) return;
        this.previous.addEventListener('click', () => this.showPage(this.page - 1));
        this.next.addEventListener('click', () => this.showPage(this.page + 1));
        this.showPage(0);
      }
      showPage(page) {
        const pages = Math.ceil(this.items.length / 4);
        this.page = Math.max(0, Math.min(page, pages - 1));
        this.items.forEach((item, index) => {
          item.hidden = index < this.page * 4 || index >= (this.page + 1) * 4;
        });
        this.previous.disabled = this.page === 0;
        this.next.disabled = this.page === pages - 1;
        this.pageLabel.textContent = `${this.page + 1} / ${pages}`;
      }
    }
    customElements.define(tagName, WallOfFame);
  })();
</script>

{% schema %}
{
  "name": "Wall of fame gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wall of Fame" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "image_gap", "label": "Image gap", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "section_padding", "label": "Vertical padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 24 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#121212" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "header", "content": "Gallery images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "image_picker", "id": "image_7", "label": "Image 7" },
    { "type": "image_picker", "id": "image_8", "label": "Image 8" },
    { "type": "image_picker", "id": "image_9", "label": "Image 9" },
    { "type": "image_picker", "id": "image_10", "label": "Image 10" },
    { "type": "image_picker", "id": "image_11", "label": "Image 11" },
    { "type": "image_picker", "id": "image_12", "label": "Image 12" }
  ],
  "presets": [{ "name": "Wall of fame gallery" }],
  "tag": null,
  "class": "wall-of-fame-gallery"
}
{% endschema %}