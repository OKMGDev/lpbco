{% doc %}
  @prompt
    Create a grouped product section for the All products collection page. Display three distinct groups with headings Beer, Merch, and Gift Cards, with the matching products directly beneath each heading. Let the merchant select the collection supplying products for each group. Match the theme's existing product card styling and responsive layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grouped-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: rgb(var(--color-foreground));
  }

  .ai-grouped-products-{{ ai_gen_id }}__group {
    margin-bottom: 4rem;
  }

  .ai-grouped-products-{{ ai_gen_id }}__heading {
    margin: 0 0 2rem;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    line-height: calc(1 + 0.3 / var(--font-heading-scale));
    font-size: calc(var(--font-heading-scale) * 2.4rem);
  }

  .ai-grouped-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 3rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-grouped-products-{{ ai_gen_id }}__item {
    min-width: 0;
  }

  .ai-grouped-products-{{ ai_gen_id }}__card {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .ai-grouped-products-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
    aspect-ratio: 1 / 1;
    margin-bottom: 1rem;
  }

  .ai-grouped-products-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-grouped-products-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-grouped-products-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-grouped-products-{{ ai_gen_id }}__info {
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-grouped-products-{{ ai_gen_id }}__title {
    display: block;
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
    line-height: calc(1 + 0.5 / var(--font-body-scale));
    overflow-wrap: anywhere;
  }

  .ai-grouped-products-{{ ai_gen_id }}__price {
    font-size: 1.4rem;
    line-height: calc(1 + 0.5 / var(--font-body-scale));
  }

  .ai-grouped-products-{{ ai_gen_id }}__empty {
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (max-width: 749px) {
    .ai-grouped-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 2.5rem 1rem;
    }

    .ai-grouped-products-{{ ai_gen_id }}__heading {
      font-size: calc(var(--font-heading-scale) * 2rem);
    }
  }
{% endstyle %}

<div class="ai-grouped-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for group_number in (1..3) %}
    {% liquid
      assign group_heading_key = 'group_' | append: group_number | append: '_heading'
      assign group_collection_key = 'group_' | append: group_number | append: '_collection'
      assign group_heading = block.settings[group_heading_key]
      assign group_collection = block.settings[group_collection_key]
    %}
    {% if group_heading != blank or group_collection != blank %}
      <section class="ai-grouped-products-{{ ai_gen_id }}__group" aria-labelledby="ai-grouped-heading-{{ ai_gen_id }}-{{ group_number }}">
        {% if group_heading != blank %}
          <h2 id="ai-grouped-heading-{{ ai_gen_id }}-{{ group_number }}" class="ai-grouped-products-{{ ai_gen_id }}__heading">{{ group_heading | escape }}</h2>
        {% endif %}
        {% if group_collection != blank and group_collection.products.size > 0 %}
          <ul class="ai-grouped-products-{{ ai_gen_id }}__grid" role="list">
            {% for product in group_collection.products limit: block.settings.products_to_show %}
              <li class="ai-grouped-products-{{ ai_gen_id }}__item">
                <a class="ai-grouped-products-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  <div class="ai-grouped-products-{{ ai_gen_id }}__media">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '180, 360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title | escape }}
                    {% else %}
                      <div class="ai-grouped-products-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
                    {% endif %}
                  </div>
                  <div class="ai-grouped-products-{{ ai_gen_id }}__info">
                    <span class="ai-grouped-products-{{ ai_gen_id }}__title">{{ product.title | escape }}</span>
                    <span class="ai-grouped-products-{{ ai_gen_id }}__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>
                  </div>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% elsif group_collection == blank %}
          <p class="ai-grouped-products-{{ ai_gen_id }}__empty">Choose a collection for this group in the block settings.</p>
        {% endif %}
      </section>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Grouped products",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "products_to_show", "label": "Products per group", "min": 4, "max": 20, "step": 4, "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "card_text_alignment", "label": "Card text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "header", "content": "Beer" },
    { "type": "text", "id": "group_1_heading", "label": "Heading", "default": "Beer" },
    { "type": "collection", "id": "group_1_collection", "label": "Product collection" },
    { "type": "header", "content": "Merch" },
    { "type": "text", "id": "group_2_heading", "label": "Heading", "default": "Merch" },
    { "type": "collection", "id": "group_2_collection", "label": "Product collection" },
    { "type": "header", "content": "Gift cards" },
    { "type": "text", "id": "group_3_heading", "label": "Heading", "default": "Gift Cards" },
    { "type": "collection", "id": "group_3_collection", "label": "Product collection" }
  ],
  "presets": [{ "name": "Grouped products" }],
  "tag": null,
  "class": "grouped-products-block"
}
{% endschema %}